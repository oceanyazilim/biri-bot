# ───────────────────────── Biri • Ortam Değişkenleri ─────────────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env dosyasını asla paylaşmayın.

# development | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Discord Developer Portal → Uygulamanız → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → Uygulamanız → General Information → Application ID
DISCORD_CLIENT_ID=
# Doluysa komutlar yalnızca bu sunucuya anında kaydedilir (geliştirme için önerilir).
# Boş bırakılırsa komutlar global kaydedilir (yayılması bir saate kadar sürebilir).
DEV_GUILD_ID=

# PostgreSQL (üretim):
DATABASE_URL=postgresql://biri:sifre@localhost:5432/biri?schema=public
# SQLite (yerel geliştirme, `npm run db:sqlite` ile). Yol prisma/sqlite klasörüne göredir:
# DATABASE_URL=file:./dev.db

# Her başlangıçta slash komutlarını otomatik kaydet (true/false)
AUTO_DEPLOY_COMMANDS=true

# Silinen/düzenlenen mesaj logları (💬・biri-mesaj-log). Developer Portal'da "Message Content Intent" açık olmalı.
ENABLE_MESSAGE_LOGS=false

# Ayrıcalıklı "Server Members Intent". Açarsanız Developer Portal'da da etkinleştirin.
# Üye katılma/ayrılma logları (hesap yaşı, roller) ve kick için ek doğrulama sağlar; Guard bu olmadan da çalışır.
ENABLE_GUILD_MEMBERS_INTENT=false

# /health uç noktası için port (0 = kapalı)
HEALTH_PORT=0

# Gateway olayının eşleşen denetim kaydını bekleme süresi (ms) ve yedek sorgu limiti
AUDIT_CORRELATION_WINDOW_MS=2500
AUDIT_FETCH_LIMIT=25

# Komut bekleme süresi (ms), log gönderim aralığı (ms), sunucu başına eşzamanlı oda oluşturma
COMMAND_COOLDOWN_MS=3000
LOG_FLUSH_INTERVAL_MS=2000
ROOM_CREATION_CONCURRENCY=3
